{
  "name": "component-cop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "package:chrome": "npm run check && npm test && wxt zip -b chrome",
    "package:firefox": "npm run check && npm test && wxt zip -b firefox --sources",
    "zip": "wxt zip -b chrome",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@wxt-dev/module-react": "^1.1.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "wxt": "^0.20.5"
  }
}
